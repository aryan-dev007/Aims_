# ============================================================
# AIMS backend environment (COPY to .env and fill in real values)
# Never commit the real .env — only this example.
# ============================================================

# ---- PostgreSQL ----
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=aims_inventory

# ---- Backend ----
PORT=4000
# Optional overrides
# DATA_FILE=
# PREDICT_SERVER=http://127.0.0.1:5555
# PYTHON_BIN=

# ---- n8n low-stock email integration ----
# Backend POSTs a low-stock event here the moment a product drops below its
# threshold. Point it at your n8n Webhook node URL.
ALERT_WEBHOOK_URL=http://localhost:5678/webhook/low-stock-alert
# Shared secret sent as the X-AIMS-Token header (n8n validates it).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ALERT_WEBHOOK_TOKEN=replace-with-a-long-random-secret
# Timeout for the webhook push, milliseconds.
ALERT_WEBHOOK_TIMEOUT_MS=8000
# Inventory owner who receives the low-stock emails (goes into the payload).
INVENTORY_OWNER_EMAIL=owner@example.com
# Optional: require this token on the inbound POST /api/webhook/n8n route.
# Leave blank to keep that route open. Defaults to ALERT_WEBHOOK_TOKEN.
# N8N_INBOUND_TOKEN=
