{
  "name": "stock-monitor-backend",
  "version": "1.0.0",
  "description": "Node.js backend for the YOLO stock monitoring system: ingests vision counts, persists inventory, generates low-stock alerts and procurement recommendations.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/migrate.js",
    "db:test": "node src/test_pg.js",
    "test:auth": "node test/auth.test.js",
    "test:lowstock": "node test/lowstock.test.js",
    "test:invoice-parser": "node test/invoiceParser.test.js",
    "test:invoice-workflow": "node test/invoiceWorkflow.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3"
  },
  "engines": {
    "node": ">=18"
  }
}
