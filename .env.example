# Copy to .env, then change the placeholders before starting the stack.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Owner credentials for manual stock changes and invoice stock receipts.
OWNER_USERNAME=owner
OWNER_PASSWORD=replace-with-a-strong-owner-password
JWT_SECRET=replace-with-at-least-32-random-characters

# Addresses where people open the dashboard (comma-separated).
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
APP_PORT=8080
BACKEND_PORT=4000

# Webhook URL of the n8n system, reachable from this Docker host.
ALERT_WEBHOOK_URL=http://N8N_HOST_OR_IP:5678/webhook/low-stock-alert
# Must match N8N_WEBHOOK_TOKEN configured on n8n.
ALERT_WEBHOOK_TOKEN=replace-with-a-long-random-secret
INVENTORY_OWNER_EMAIL=owner@example.com

# Optional token required by POST /api/webhook/n8n.
# Set the same value on n8n as needed.
N8N_INBOUND_TOKEN=replace-with-another-long-random-secret
