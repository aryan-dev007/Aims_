{
  "name": "AIMS Low-Stock Email Alerts",
  "nodes": [
    {
      "id": "webhook-lowstock",
      "name": "Webhook (low stock)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-240, -40],
      "webhookId": "low-stock-alert",
      "parameters": {
        "httpMethod": "POST",
        "path": "low-stock-alert",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "validate",
      "name": "Valid + authorized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-20, -40],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c-token",
              "leftValue": "={{ $json.headers['x-aims-token'] }}",
              "rightValue": "={{ $env.N8N_WEBHOOK_TOKEN }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "c-items",
              "leftValue": "={{ ($json.body.items || []).length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            },
            {
              "id": "c-event",
              "leftValue": "={{ $json.body.event }}",
              "rightValue": "low_stock",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "prepare-email",
      "name": "Prepare email",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, -140],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a-to",
              "name": "toEmail",
              "value": "={{ $json.body.ownerEmail || $env.INVENTORY_OWNER_EMAIL || $env.ADMIN_EMAIL }}",
              "type": "string"
            },
            {
              "id": "a-subject",
              "name": "subject",
              "value": "={{ $json.body.subject }}",
              "type": "string"
            },
            {
              "id": "a-message",
              "name": "message",
              "value": "={{ $json.body.message }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "email-admin",
      "name": "Email owner (low stock)",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [480, -140],
      "parameters": {
        "fromEmail": "={{ $env.ALERT_FROM_EMAIL || $env.INVENTORY_OWNER_EMAIL || $env.ADMIN_EMAIL || $json.toEmail }}",
        "toEmail": "={{ $json.toEmail }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.message }}",
        "options": {}
      }
    },
    {
      "id": "respond-ok",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, -140],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, accepted: true, itemCount: $json.itemCount || null }) }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "respond-unauth",
      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [220, 80],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, error: 'unauthorized or invalid payload' }) }}",
        "options": {
          "responseCode": 401
        }
      }
    },
    {
      "id": "schedule",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-240, 320],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "get-reorder",
      "name": "Fetch reorder recommendations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-20, 320],
      "parameters": {
        "method": "GET",
        "url": "={{$env.BACKEND_URL}}/api/reorder",
        "options": {},
        "response": {
          "responseFormat": "json"
        }
      }
    },
    {
      "id": "has-items",
      "name": "Needs replenishment?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [200, 320],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c-reorder",
              "leftValue": "={{ $json.itemCount }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "create-order",
      "name": "Create procurement order",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 240],
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_URL}}/api/orders",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ source: 'n8n', items: $json.items.map(i => ({ sku: i.sku, qty: i.reorderQty })) }) }}",
        "options": {},
        "response": {
          "responseFormat": "json"
        }
      }
    },
    {
      "id": "noop-when-ok",
      "name": "Stock is fine",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [440, 420]
    }
  ],
  "connections": {
    "webhook-lowstock": {
      "main": [
        [
          {
            "node": "validate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "validate": {
      "main": [
        [
          {
            "node": "prepare-email",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "respond-unauth",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "prepare-email": {
      "main": [
        [
          {
            "node": "email-admin",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "email-admin": {
      "main": [
        [
          {
            "node": "respond-ok",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "schedule": {
      "main": [
        [
          {
            "node": "get-reorder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "get-reorder": {
      "main": [
        [
          {
            "node": "has-items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "has-items": {
      "main": [
        [
          {
            "node": "create-order",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "noop-when-ok",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
